# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (frontend-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# --- Supabase (server-only, bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional model overrides
AI_TEXT_MODEL=gpt-4o-mini
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova
AI_IMAGE_MODEL=gpt-image-1

# --- PayPal ---
# Use sandbox creds + PAYPAL_ENV=sandbox while testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Billing plan IDs you create in the PayPal dashboard (one per tier).
PAYPAL_PLAN_BASIC_ID=
PAYPAL_PLAN_PRO_ID=
PAYPAL_PLAN_PREMIUM_ID=
