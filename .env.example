# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (frontend-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# --- Supabase (server-only, bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- AI providers ---
# Story text: provider auto-selects 'gemini' if GEMINI_API_KEY is set, otherwise 'openai'.
# Set explicitly to override.
AI_TEXT_PROVIDER=gemini
# Override the default model. Defaults: gemini-2.5-flash (Gemini), gpt-4o-mini (OpenAI).
# AI_TEXT_MODEL=gemini-2.5-flash

# Google Gemini (free tier — get a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (used for TTS audio + image generation, optionally for story text)
OPENAI_API_KEY=sk-...
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova
AI_IMAGE_MODEL=gpt-image-1

# --- PayPal ---
# Use sandbox creds + PAYPAL_ENV=sandbox while testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Billing plan IDs you create in the PayPal dashboard (one per tier).
PAYPAL_PLAN_BASIC_ID=
PAYPAL_PLAN_PRO_ID=
PAYPAL_PLAN_PREMIUM_ID=
